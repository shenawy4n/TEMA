# ==============================================================================
# TEMA Server-Side Environment Variables (Placeholders Only)
# ==============================================================================
# NEVER put real secrets here or commit .env / .env.local to Git.
# NEVER prefix private API keys with VITE_ (Vite exposes VITE_* to the browser).

# Server-only Gemini API key for local Express development (in production, use
# Google Cloud Secret Manager via Firebase Functions defineSecret('GEMINI_API_KEY')).
GEMINI_API_KEY="REPLACE_WITH_LOCAL_SERVER_ONLY_GEMINI_KEY"

# Public URL of the running application (auto-injected in AI Studio Build Mode)
APP_URL="http://localhost:3000"

# Comma-separated explicit server-side CORS origins (NEVER use wildcard '*').
# Examples:
#   Local / AI Studio preview: https://your-preview-host.run.app
#   Firebase Hosting:          https://your-project-id.web.app,https://your-project-id.firebaseapp.com
#   Custom domain:             https://app.tema.edu.eg
ALLOWED_ORIGINS="https://your-project-id.web.app,https://your-project-id.firebaseapp.com"

# Optional public endpoint URL if pointing frontend to deployed Cloud Function
# (Never put an API key in any VITE_* variable!)
# VITE_GEMINI_ENDPOINT="https://europe-west1-YOUR_PROJECT_ID.cloudfunctions.net/geminiGenerate"
