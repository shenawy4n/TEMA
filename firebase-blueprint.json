{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account preferences and organization memberships index.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "activeOrganizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "organizationIds": {
          "type": "array",
          "description": "Bounded list of organization IDs (max 10) this user belongs to."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "themePreference", "organizationIds", "createdAt", "updatedAt"]
    },
