  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile and bounded organization index."
    },
    "/organizations/{organizationId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Multi-tenant organization root document."
    },
    "/organizations/{organizationId}/members/{userId}": {
      "schema": { "$ref": "#/entities/OrganizationMember" },
      "description": "Organization membership and role authorization source of truth."
    },
    "/organizations/{organizationId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students enrolled in the organization."
    },
    "/organizations/{organizationId}/groups/{groupId}": {
      "schema": { "$ref": "#/entities/StudyGroup" },
      "description": "Academic groups within the organization."
    },
    "/organizations/{organizationId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ClassSession" },
      "description": "Scheduled class sessions within the organization."
    },
    "/organizations/{organizationId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Attendance records linked to sessions and students."
    },
    "/organizations/{organizationId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Auditable student payment records in EGP."
    },
    "/organizations/{organizationId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "Auditable operational expense records in EGP."
    },
    "/organizations/{organizationId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only organization audit log."
    },
    "/organizations/{organizationId}/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/StaffInvitation" },
      "description": "Staff invitation records created by organization owners."
    }
  }
}
