          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250
        },
        "currency": {
          "type": "string",
          "enum": ["EGP"]
        },
        "language": {
          "type": "string",
          "enum": ["ar"]
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "academicYear": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
