rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Primitive Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStrLen(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegInt(val) {
      return val is int && val >= 0;
    }

    function isPosInt(val) {
      return val is int && val > 0;
    }

    function hasOrgDoc(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId));
    }

    function getOrgData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function isActiveOrganization(orgId) {
      return hasOrgDoc(orgId) && getOrgData(orgId).status == 'active';
    }

    function hasValidMemberDoc(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function getMemberData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    function isActiveMember(orgId) {
      return isVerifiedUser()
        && isActiveOrganization(orgId)
        && hasValidMemberDoc(orgId)
        && getMemberData(orgId).status == 'active'
        && getMemberData(orgId).organizationId == orgId;
    }

    function hasAnyRole(orgId, allowedRoles) {
      return isActiveMember(orgId) && getMemberData(orgId).role in allowedRoles;
    }

    function isOrgOwner(orgId) {
      return hasAnyRole(orgId, ['owner']);
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'themePreference', 'organizationIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'themePreference', 'activeOrganizationId', 'organizationIds', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && isValidId(data.uid)
        && isStrLen(data.displayName, 1, 100)
        && isStrLen(data.email, 3, 200)
        && (!('phone' in data) || isStrLen(data.phone, 0, 30))
        && data.themePreference in ['light', 'dark', 'system']
        && (!('activeOrganizationId' in data) || isValidId(data.activeOrganizationId))
        && data.organizationIds is list
        && data.organizationIds.size() <= 10
        && (data.organizationIds.size() == 0 || isValidId(data.organizationIds[0]))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrganization(data, orgId) {
      return data.keys().hasAll([
          'id', 'name', 'type', 'ownerId', 'ownerName', 'phone', 'email', 'city',
          'currency', 'language', 'themePreference', 'academicYear', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'type', 'ownerId', 'ownerName', 'phone', 'email', 'city', 'address',
          'currency', 'language', 'themePreference', 'academicYear', 'status',
          'totalStudentsCount', 'activeStudentsCount', 'inactiveStudentsCount', 'archivedStudentsCount',
          'createdAt', 'updatedAt'
        ])
        && data.id == orgId
        && isValidId(data.id)
        && isStrLen(data.name, 2, 120)
        && data.type in ['independent_teacher', 'educational_center']
        && isValidId(data.ownerId)
        && isStrLen(data.ownerName, 2, 100)
        && isStrLen(data.phone, 5, 30)
        && isStrLen(data.email, 3, 200)
        && isStrLen(data.city, 2, 80)
        && (!('address' in data) || isStrLen(data.address, 0, 250))
        && data.currency == 'EGP'
        && data.language == 'ar'
        && data.themePreference in ['light', 'dark', 'system']
        && isStrLen(data.academicYear, 4, 30)
        && data.status in ['active', 'suspended']
        && (!('totalStudentsCount' in data) || isNonNegInt(data.totalStudentsCount))
        && (!('activeStudentsCount' in data) || isNonNegInt(data.activeStudentsCount))
        && (!('inactiveStudentsCount' in data) || isNonNegInt(data.inactiveStudentsCount))
        && (!('archivedStudentsCount' in data) || isNonNegInt(data.archivedStudentsCount))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrganizationMember(data, orgId, memberUid) {
      return data.keys().hasAll([
          'uid', 'organizationId', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'organizationId', 'displayName', 'email', 'role', 'status', 'invitedBy', 'createdAt', 'updatedAt'
        ])
        && data.uid == memberUid
        && isValidId(data.uid)
        && data.organizationId == orgId
        && isValidId(data.organizationId)
        && isStrLen(data.displayName, 1, 100)
        && isStrLen(data.email, 3, 200)
        && data.role in ['owner', 'teacher', 'assistant', 'accountant']
        && data.status in ['active', 'invited', 'suspended']
        && (!('invitedBy' in data) || isValidId(data.invitedBy))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data, orgId, studentId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'fullName', 'phone', 'gradeLevel', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'fullName', 'phone', 'guardianName', 'guardianPhone',
          'gradeLevel', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == studentId
        && isValidId(data.id)
        && data.organizationId == orgId
        && isStrLen(data.fullName, 2, 120)
        && isStrLen(data.phone, 5, 30)
        && (!('guardianName' in data) || isStrLen(data.guardianName, 0, 120))
        && (!('guardianPhone' in data) || isStrLen(data.guardianPhone, 0, 30))
        && isStrLen(data.gradeLevel, 1, 60)
        && data.status in ['active', 'inactive', 'archived']
        && (!('notes' in data) || isStrLen(data.notes, 0, 500))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroup(data, orgId, groupId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'name', 'subject', 'gradeLevel', 'teacherId', 'teacherName',
          'capacity', 'studentCount', 'monthlyFee', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'name', 'subject', 'gradeLevel', 'teacherId', 'teacherName',
          'capacity', 'studentCount', 'lastEnrollmentId', 'scheduleSummary', 'monthlyFee', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == groupId
        && isValidId(data.id)
        && data.organizationId == orgId
        && isStrLen(data.name, 2, 120)
        && isStrLen(data.subject, 1, 80)
        && isStrLen(data.gradeLevel, 1, 60)
        && isValidId(data.teacherId)
        && isStrLen(data.teacherName, 1, 100)
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 500
        && data.studentCount is int && data.studentCount >= 0 && data.studentCount <= data.capacity
        && (!('lastEnrollmentId' in data) || isValidId(data.lastEnrollmentId))
        && (!('scheduleSummary' in data) || isStrLen(data.scheduleSummary, 0, 150))
        && data.monthlyFee is number && data.monthlyFee >= 0
        && data.status in ['active', 'paused', 'archived']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEnrollment(data, orgId, enrollmentId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'groupId', 'studentId', 'studentName', 'groupName',
          'status', 'enrolledBy', 'enrolledAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'groupId', 'studentId', 'studentName', 'groupName',
          'status', 'enrolledBy', 'removedBy', 'enrolledAt', 'removedAt', 'createdAt', 'updatedAt'
        ])
        && data.id == enrollmentId
        && isValidId(data.groupId)
        && isValidId(data.studentId)
        && enrollmentId == (data.groupId + '_' + data.studentId)
        && data.organizationId == orgId
        && isStrLen(data.studentName, 1, 120)
        && isStrLen(data.groupName, 1, 120)
        && data.status in ['active', 'removed']
        && isValidId(data.enrolledBy)
        && (!('removedBy' in data) || isValidId(data.removedBy))
        && data.enrolledAt is timestamp
        && (!('removedAt' in data) || data.removedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSession(data, orgId, sessionId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'groupId', 'groupName', 'teacherId', 'teacherName',
          'title', 'date', 'startTime', 'endTime', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'groupId', 'groupName', 'teacherId', 'teacherName',
          'title', 'date', 'startTime', 'endTime', 'room', 'status',
          'cancellationReason', 'rescheduleHistory', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == sessionId
        && isValidId(data.id)
        && data.organizationId == orgId
        && isValidId(data.groupId)
        && isStrLen(data.groupName, 1, 120)
        && isValidId(data.teacherId)
        && isStrLen(data.teacherName, 1, 100)
        && isStrLen(data.title, 2, 150)
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.endTime > data.startTime
        && (!('room' in data) || isStrLen(data.room, 0, 80))
        && (!('cancellationReason' in data) || isStrLen(data.cancellationReason, 0, 200))
        && (!('rescheduleHistory' in data) || (data.rescheduleHistory is list && data.rescheduleHistory.size() <= 20))
        && data.status in ['scheduled', 'completed', 'cancelled']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data, orgId, attendanceId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'sessionId', 'studentId', 'studentName', 'groupId',
          'status', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'sessionId', 'studentId', 'studentName', 'groupId',
          'status', 'note', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.id == attendanceId
        && isValidId(data.id)
        && isValidId(data.sessionId)
        && isValidId(data.studentId)
        && attendanceId == (data.sessionId + '_' + data.studentId)
        && data.organizationId == orgId
        && isStrLen(data.studentName, 1, 120)
        && isValidId(data.groupId)
        && data.status in ['present', 'absent', 'late', 'excused']
        && (!('note' in data) || isStrLen(data.note, 0, 300))
        && isValidId(data.recordedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data, orgId, paymentId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'studentId', 'studentName', 'amount', 'paidAmount', 'dueAmount',
          'currency', 'category', 'method', 'status', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'studentId', 'studentName', 'groupId',
          'amount', 'paidAmount', 'dueAmount',
          'amountPiasters', 'paidAmountPiasters', 'dueAmountPiasters',
          'currency', 'category', 'method', 'status', 'paymentDate',
          'referenceNumber', 'idempotencyKey', 'notes',
          'voidReason', 'voidedBy', 'voidedAt',
          'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.id == paymentId
        && isValidId(data.id)
        && data.organizationId == orgId
        && isValidId(data.studentId)
        && isStrLen(data.studentName, 1, 120)
        && (!('groupId' in data) || isStrLen(data.groupId, 0, 128))
        && data.amount is number && data.amount > 0
        && data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.amount
        && data.dueAmount is number && data.dueAmount >= 0
        && isPosInt(data.amountPiasters)
        && isNonNegInt(data.paidAmountPiasters)
        && isNonNegInt(data.dueAmountPiasters)
        && data.paidAmountPiasters <= data.amountPiasters
        && (data.paidAmountPiasters + data.dueAmountPiasters) == data.amountPiasters
        && data.currency == 'EGP'
        && data.category in ['tuition', 'materials', 'registration', 'other']
        && data.method in ['cash', 'vodafone_cash', 'instapay', 'bank_transfer', 'card']
        && data.status in ['posted', 'partial', 'pending', 'voided']
        && (
          data.status == 'voided'
          || (data.status == 'posted' && data.dueAmountPiasters == 0 && data.paidAmountPiasters == data.amountPiasters)
          || (data.status == 'partial' && data.paidAmountPiasters > 0 && data.dueAmountPiasters > 0)
          || (data.status == 'pending' && data.paidAmountPiasters == 0 && data.dueAmountPiasters == data.amountPiasters)
        )
        && (!('paymentDate' in data) || (data.paymentDate is string && data.paymentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('referenceNumber' in data) || isStrLen(data.referenceNumber, 0, 80))
        && (!('idempotencyKey' in data) || isValidId(data.idempotencyKey))
        && (!('notes' in data) || isStrLen(data.notes, 0, 300))
        && (!('voidReason' in data) || isStrLen(data.voidReason, 3, 200))
        && (!('voidedBy' in data) || isValidId(data.voidedBy))
        && (!('voidedAt' in data) || data.voidedAt is timestamp)
        && isValidId(data.recordedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, orgId, expenseId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'title', 'category', 'amount', 'currency',
          'status', 'expenseDate', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'title', 'category', 'amount', 'amountPiasters', 'currency',
          'status', 'expenseDate', 'idempotencyKey', 'notes',
          'voidReason', 'voidedBy', 'voidedAt',
          'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.id == expenseId
        && isValidId(data.id)
        && data.organizationId == orgId
        && isStrLen(data.title, 2, 150)
        && data.category in ['rent', 'salaries', 'utilities', 'printing', 'marketing', 'other']
        && data.amount is number && data.amount > 0
        && isPosInt(data.amountPiasters)
        && data.currency == 'EGP'
        && data.status in ['posted', 'voided']
        && data.expenseDate is string && data.expenseDate.size() == 10 && data.expenseDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('idempotencyKey' in data) || isValidId(data.idempotencyKey))
        && (!('notes' in data) || isStrLen(data.notes, 0, 300))
        && (!('voidReason' in data) || isStrLen(data.voidReason, 3, 200))
        && (!('voidedBy' in data) || isValidId(data.voidedBy))
        && (!('voidedAt' in data) || data.voidedAt is timestamp)
        && isValidId(data.recordedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLedgerEntry(data, orgId, entryId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'entryType', 'direction', 'entityType', 'entityId',
          'amountPiasters', 'amount', 'currency', 'description', 'recordedBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'entryType', 'direction', 'entityType', 'entityId',
          'studentId', 'studentName', 'groupId', 'amountPiasters', 'amount', 'currency',
          'description', 'relatedEntryId', 'idempotencyKey', 'recordedBy', 'createdAt'
        ])
        && data.id == entryId
        && isValidId(data.id)
        && data.organizationId == orgId
        && data.entryType in ['charge', 'payment', 'reversal', 'adjustment']
        && data.direction in ['debit', 'credit']
        && data.entityType in ['payment', 'expense']
        && isValidId(data.entityId)
        && (
          (data.entityType == 'payment' && 'studentId' in data && isValidId(data.studentId))
          ||
          (data.entityType == 'expense' && !('studentId' in data) && !('groupId' in data) && !('relatedEntryId' in data))
        )
        && (!('studentId' in data) || isValidId(data.studentId))
        && (!('studentName' in data) || isStrLen(data.studentName, 1, 120))
        && (!('groupId' in data) || data.groupId == '' || isValidId(data.groupId))
        && isPosInt(data.amountPiasters)
        && data.amount is number && data.amount > 0
        && math.abs((data.amount * 100) - data.amountPiasters) < 0.001
        && data.currency == 'EGP'
        && isStrLen(data.description, 2, 300)
        && (!('relatedEntryId' in data) || isValidId(data.relatedEntryId))
        && (!('idempotencyKey' in data) || isValidId(data.idempotencyKey))
        && isValidId(data.recordedBy)
        && data.createdAt is timestamp;
    }

    function hasPaymentDoc(orgId, paymentId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/payments/$(paymentId));
    }

    function hasPaymentDocAfter(orgId, paymentId) {
      return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/payments/$(paymentId));
    }

    function getPaymentBefore(orgId, paymentId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/payments/$(paymentId)).data;
    }

    function getPaymentAfter(orgId, paymentId) {
      return getAfter(/databases/$(database)/documents/organizations/$(orgId)/payments/$(paymentId)).data;
    }

    function hasExpenseDoc(orgId, expenseId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/expenses/$(expenseId));
    }

    function hasExpenseDocAfter(orgId, expenseId) {
      return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/expenses/$(expenseId));
    }

    function getExpenseBefore(orgId, expenseId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/expenses/$(expenseId)).data;
    }

    function getExpenseAfter(orgId, expenseId) {
      return getAfter(/databases/$(database)/documents/organizations/$(orgId)/expenses/$(expenseId)).data;
    }

    function matchesPaymentGroupId(payData, entryData) {
      return (
        ((!('groupId' in payData) || payData.groupId == '') && (!('groupId' in entryData) || entryData.groupId == ''))
        || ('groupId' in payData && 'groupId' in entryData && payData.groupId == entryData.groupId)
      );
    }

    function isValidPaymentCreateChargeLedger(orgId, entryId) {
      return hasAnyRole(orgId, ['owner', 'accountant', 'assistant'])
        && incoming().entityType == 'payment'
        && incoming().entryType == 'charge'
        && incoming().direction == 'debit'
        && !('relatedEntryId' in incoming())
        && entryId == (incoming().entityId + '_charge')
        && !hasPaymentDoc(orgId, incoming().entityId)
        && hasPaymentDocAfter(orgId, incoming().entityId)
        && getPaymentAfter(orgId, incoming().entityId).organizationId == orgId
        && getPaymentAfter(orgId, incoming().entityId).createdAt == request.time
        && getPaymentAfter(orgId, incoming().entityId).status != 'voided'
        && incoming().studentId == getPaymentAfter(orgId, incoming().entityId).studentId
        && matchesPaymentGroupId(getPaymentAfter(orgId, incoming().entityId), incoming())
        && incoming().amountPiasters == getPaymentAfter(orgId, incoming().entityId).amountPiasters;
    }

    function isValidPaymentCreateInitPayLedger(orgId, entryId) {
      return hasAnyRole(orgId, ['owner', 'accountant', 'assistant'])
        && incoming().entityType == 'payment'
        && incoming().entryType == 'payment'
        && incoming().direction == 'credit'
        && 'relatedEntryId' in incoming()
        && incoming().relatedEntryId == (incoming().entityId + '_charge')
        && entryId == (incoming().entityId + '_pay_init')
        && !hasPaymentDoc(orgId, incoming().entityId)
        && hasPaymentDocAfter(orgId, incoming().entityId)
        && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/ledgerEntries/$(incoming().entityId + '_charge'))
        && getPaymentAfter(orgId, incoming().entityId).organizationId == orgId
        && getPaymentAfter(orgId, incoming().entityId).createdAt == request.time
        && getPaymentAfter(orgId, incoming().entityId).status in ['posted', 'partial']
        && getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters > 0
        && incoming().studentId == getPaymentAfter(orgId, incoming().entityId).studentId
        && matchesPaymentGroupId(getPaymentAfter(orgId, incoming().entityId), incoming())
        && incoming().amountPiasters == getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters;
    }

    function isValidPaymentSettlementLedger(orgId, entryId) {
      return hasAnyRole(orgId, ['owner', 'accountant', 'assistant'])
        && incoming().entityType == 'payment'
        && incoming().entryType == 'payment'
        && incoming().direction == 'credit'
        && !('relatedEntryId' in incoming())
        && hasPaymentDoc(orgId, incoming().entityId)
        && hasPaymentDocAfter(orgId, incoming().entityId)
        && getPaymentBefore(orgId, incoming().entityId).organizationId == orgId
        && getPaymentAfter(orgId, incoming().entityId).organizationId == orgId
        && getPaymentBefore(orgId, incoming().entityId).status in ['pending', 'partial']
        && getPaymentAfter(orgId, incoming().entityId).status in ['partial', 'posted']
        && getPaymentAfter(orgId, incoming().entityId).updatedAt == request.time
        && getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters > 0
        && (!('paidAmountPiasters' in getPaymentBefore(orgId, incoming().entityId))
            || getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters > getPaymentBefore(orgId, incoming().entityId).paidAmountPiasters)
        && incoming().studentId == getPaymentAfter(orgId, incoming().entityId).studentId
        && matchesPaymentGroupId(getPaymentAfter(orgId, incoming().entityId), incoming())
        && entryId == (incoming().entityId + '_pay_' + string(getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters))
        && (
          ('paidAmountPiasters' in getPaymentBefore(orgId, incoming().entityId)
            && incoming().amountPiasters == (getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters - getPaymentBefore(orgId, incoming().entityId).paidAmountPiasters))
          ||
          (!('paidAmountPiasters' in getPaymentBefore(orgId, incoming().entityId))
            && math.abs(((getPaymentBefore(orgId, incoming().entityId).paidAmount * 100) + incoming().amountPiasters) - getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters) < 0.5)
        );
    }

    function isValidPaymentReversalLedger(orgId, entryId) {
      return hasAnyRole(orgId, ['owner', 'accountant'])
        && incoming().entityType == 'payment'
        && incoming().entryType == 'reversal'
        && !('relatedEntryId' in incoming())
        && hasPaymentDoc(orgId, incoming().entityId)
        && hasPaymentDocAfter(orgId, incoming().entityId)
        && getPaymentBefore(orgId, incoming().entityId).organizationId == orgId
        && getPaymentAfter(orgId, incoming().entityId).organizationId == orgId
        && getPaymentBefore(orgId, incoming().entityId).status != 'voided'
        && getPaymentAfter(orgId, incoming().entityId).status == 'voided'
        && getPaymentAfter(orgId, incoming().entityId).voidedAt == request.time
        && getPaymentAfter(orgId, incoming().entityId).updatedAt == request.time
        && incoming().studentId == getPaymentAfter(orgId, incoming().entityId).studentId
        && matchesPaymentGroupId(getPaymentAfter(orgId, incoming().entityId), incoming())
        && (
          (
            entryId == (incoming().entityId + '_rev_charge')
            && incoming().direction == 'credit'
            && incoming().amountPiasters == getPaymentAfter(orgId, incoming().entityId).amountPiasters
          )
          ||
          (
            entryId == (incoming().entityId + '_rev_paid')
            && incoming().direction == 'debit'
            && getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters > 0
            && incoming().amountPiasters == getPaymentAfter(orgId, incoming().entityId).paidAmountPiasters
          )
        );
    }

    function isValidPaymentAdjustmentLedger(orgId, entryId) {
      return hasAnyRole(orgId, ['owner', 'accountant'])
        && incoming().entityType == 'payment'
        && incoming().entryType == 'adjustment'
        && !('relatedEntryId' in incoming())
        && 'idempotencyKey' in incoming()
        && isValidId(incoming().idempotencyKey)
        && entryId == ('ldg_adj_' + incoming().idempotencyKey)
        && !exists(/databases/$(database)/documents/organizations/$(orgId)/idempotencyKeys/$(('adj_' + incoming().idempotencyKey)))
        && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/idempotencyKeys/$(('adj_' + incoming().idempotencyKey)))
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/idempotencyKeys/$(('adj_' + incoming().idempotencyKey))).data.entityType == 'ledger_entry'
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/idempotencyKeys/$(('adj_' + incoming().idempotencyKey))).data.entityId == entryId
        && hasPaymentDoc(orgId, incoming().entityId)
        && getPaymentBefore(orgId, incoming().entityId).organizationId == orgId
        && getPaymentBefore(orgId, incoming().entityId).status != 'voided'
        && incoming().studentId == getPaymentBefore(orgId, incoming().entityId).studentId
        && matchesPaymentGroupId(getPaymentBefore(orgId, incoming().entityId), incoming())
        && (
          incoming().direction == 'debit'
          || (
            'amountPiasters' in getPaymentBefore(orgId, incoming().entityId)
            && incoming().amountPiasters <= getPaymentBefore(orgId, incoming().entityId).amountPiasters
          )
          || (
            !('amountPiasters' in getPaymentBefore(orgId, incoming().entityId))
            && incoming().amount <= getPaymentBefore(orgId, incoming().entityId).amount
          )
        );
    }

    function isValidExpenseLedger(orgId, entryId) {
      return hasAnyRole(orgId, ['owner', 'accountant'])
        && incoming().entityType == 'expense'
        && !('studentId' in incoming())
        && !('groupId' in incoming())
        && !('relatedEntryId' in incoming())
        && (
          (
            incoming().entryType == 'charge'
            && incoming().direction == 'debit'
            && entryId == (incoming().entityId + '_charge')
            && !hasExpenseDoc(orgId, incoming().entityId)
            && hasExpenseDocAfter(orgId, incoming().entityId)
            && getExpenseAfter(orgId, incoming().entityId).organizationId == orgId
            && getExpenseAfter(orgId, incoming().entityId).status == 'posted'
            && getExpenseAfter(orgId, incoming().entityId).createdAt == request.time
            && incoming().amountPiasters == getExpenseAfter(orgId, incoming().entityId).amountPiasters
          )
          ||
          (
            incoming().entryType == 'reversal'
            && incoming().direction == 'credit'
            && entryId == (incoming().entityId + '_rev_charge')
            && hasExpenseDoc(orgId, incoming().entityId)
            && hasExpenseDocAfter(orgId, incoming().entityId)
            && getExpenseBefore(orgId, incoming().entityId).organizationId == orgId
            && getExpenseAfter(orgId, incoming().entityId).organizationId == orgId
            && getExpenseBefore(orgId, incoming().entityId).status != 'voided'
            && getExpenseAfter(orgId, incoming().entityId).status == 'voided'
            && getExpenseAfter(orgId, incoming().entityId).voidedAt == request.time
            && getExpenseAfter(orgId, incoming().entityId).updatedAt == request.time
            && incoming().amountPiasters == getExpenseAfter(orgId, incoming().entityId).amountPiasters
          )
        );
    }

    function isValidAuditLog(data, orgId, logId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'actorId', 'actorName', 'actorRole',
          'action', 'entityType', 'entityId', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'actorId', 'actorName', 'actorRole',
          'action', 'entityType', 'entityId', 'summary',
          'result', 'correlationId', 'metadata', 'createdAt'
        ])
        && data.id == logId
        && isValidId(data.id)
        && data.organizationId == orgId
        && data.actorId == request.auth.uid
        && isStrLen(data.actorName, 1, 100)
        && data.actorRole in ['owner', 'teacher', 'assistant', 'accountant']
        && isStrLen(data.action, 2, 100)
        && isStrLen(data.entityType, 2, 60)
        && isValidId(data.entityId)
        && isStrLen(data.summary, 2, 300)
        && (!('result' in data) || data.result in ['success', 'denied', 'failure'])
        && (!('correlationId' in data) || isValidId(data.correlationId))
        && (!('metadata' in data) || (data.metadata is map && data.metadata.keys().size() <= 10))
        && data.createdAt is timestamp;
    }

    function isValidInvitation(data, orgId, invitationId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'email', 'role', 'invitedBy', 'invitedByName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'email', 'role', 'invitedBy', 'invitedByName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id == invitationId
        && isValidId(data.id)
        && data.organizationId == orgId
        && isStrLen(data.email, 3, 200)
        && data.role in ['teacher', 'assistant', 'accountant']
        && isValidId(data.invitedBy)
        && isStrLen(data.invitedByName, 1, 100)
        && data.status in ['pending', 'accepted', 'revoked']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Users Collection (PII strictly owner-only)
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phone', 'themePreference', 'activeOrganizationId', 'organizationIds', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // =========================================================================
    // Organizations Multi-Tenant Root
    // =========================================================================
    match /organizations/{organizationId} {
      allow get: if isValidId(organizationId) && isActiveMember(organizationId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(organizationId)
        && isValidOrganization(incoming(), organizationId)
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid));

      allow update: if isValidId(organizationId)
        && isValidOrganization(incoming(), organizationId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOrgOwner(organizationId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'ownerName', 'phone', 'email', 'city', 'address', 'themePreference', 'academicYear', 'updatedAt'
            ])
          )
          ||
          (
            hasAnyRole(organizationId, ['owner', 'teacher', 'assistant', 'accountant'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalStudentsCount', 'activeStudentsCount', 'inactiveStudentsCount', 'archivedStudentsCount', 'updatedAt'
            ])
          )
        );

      allow delete: if false;

      // -----------------------------------------------------------------------
      // Organization Members (Source of Truth for Tenant RBAC)
      // -----------------------------------------------------------------------
      match /members/{userId} {
        allow get: if isValidId(organizationId) && isValidId(userId) && (
          (isVerifiedUser() && request.auth.uid == userId)
          || isActiveMember(organizationId)
        );
        allow list: if isActiveMember(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isVerifiedUser()
          && isValidId(organizationId)
          && isValidId(userId)
          && isValidOrganizationMember(incoming(), organizationId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (
              userId == request.auth.uid
              && incoming().role == 'owner'
              && incoming().status == 'active'
              && !exists(/databases/$(database)/documents/organizations/$(organizationId))
              && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerId == request.auth.uid
            )
            ||
            (
              isOrgOwner(organizationId)
              && incoming().role != 'owner'
            )
          );

        allow update: if isValidId(organizationId)
          && isValidId(userId)
          && isValidOrganizationMember(incoming(), organizationId, userId)
          && isOrgOwner(organizationId)
          && incoming().uid == existing().uid
          && incoming().organizationId == existing().organizationId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (userId != request.auth.uid && incoming().role != 'owner' && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'updatedAt']))
            ||
            (userId == request.auth.uid && incoming().role == existing().role && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
          );

        allow delete: if isValidId(organizationId)
          && isValidId(userId)
          && isOrgOwner(organizationId)
          && userId != request.auth.uid;
      }

      // -----------------------------------------------------------------------
      // Students
      // -----------------------------------------------------------------------
      match /students/{studentId} {
        allow get: if isValidId(organizationId) && isValidId(studentId) && isActiveMember(organizationId);
        allow list: if isActiveMember(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(studentId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && isValidStudent(incoming(), organizationId, studentId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(studentId)
          && isValidStudent(incoming(), organizationId, studentId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'phone', 'guardianName', 'guardianPhone', 'gradeLevel', 'status', 'notes', 'updatedAt'
          ]);

        allow delete: if isValidId(organizationId) && isValidId(studentId) && isOrgOwner(organizationId);
      }

      // -----------------------------------------------------------------------
      // Groups (studentCount protected against arbitrary client tampering)
      // -----------------------------------------------------------------------
      match /groups/{groupId} {
        allow get: if isValidId(organizationId) && isValidId(groupId) && isActiveMember(organizationId);
        allow list: if isActiveMember(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(groupId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && isValidGroup(incoming(), organizationId, groupId)
          && incoming().studentCount == 0
          && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(incoming().teacherId))
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(incoming().teacherId)).data.status == 'active'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(incoming().teacherId)).data.role in ['owner', 'teacher']
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(groupId)
          && isValidGroup(incoming(), organizationId, groupId)
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
              && incoming().studentCount == existing().studentCount
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'subject', 'gradeLevel', 'teacherId', 'teacherName', 'capacity',
                'scheduleSummary', 'monthlyFee', 'status', 'updatedAt'
              ])
            )
            ||
            (
              hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
              && 'lastEnrollmentId' in incoming()
              && incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'lastEnrollmentId', 'updatedAt'])
              && (
                (
                  incoming().studentCount == existing().studentCount + 1
                  && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/enrollments/$(incoming().lastEnrollmentId)).data.groupId == groupId
                  && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/enrollments/$(incoming().lastEnrollmentId)).data.status == 'active'
                )
                ||
                (
                  incoming().studentCount == existing().studentCount - 1
                  && get(/databases/$(database)/documents/organizations/$(organizationId)/enrollments/$(incoming().lastEnrollmentId)).data.groupId == groupId
                  && get(/databases/$(database)/documents/organizations/$(organizationId)/enrollments/$(incoming().lastEnrollmentId)).data.status == 'active'
                  && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/enrollments/$(incoming().lastEnrollmentId)).data.status == 'removed'
                )
              )
            )
            ||
            (
              hasAnyRole(organizationId, ['owner', 'accountant'])
              && incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'updatedAt'])
            )
          );

        allow delete: if isValidId(organizationId) && isValidId(groupId) && isOrgOwner(organizationId);
      }

      // -----------------------------------------------------------------------
      // Group Enrollments (Deterministic {groupId}_{studentId})
      // -----------------------------------------------------------------------
      match /enrollments/{enrollmentId} {
        allow get: if isValidId(organizationId) && isValidId(enrollmentId) && isActiveMember(organizationId);
        allow list: if isActiveMember(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(enrollmentId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && isValidEnrollment(incoming(), organizationId, enrollmentId)
          && incoming().status == 'active'
          && incoming().enrolledBy == request.auth.uid
          && get(/databases/$(database)/documents/organizations/$(organizationId)/groups/$(incoming().groupId)).data.status == 'active'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/students/$(incoming().studentId)).data.status == 'active'
          && incoming().enrolledAt == request.time
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(enrollmentId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && isValidEnrollment(incoming(), organizationId, enrollmentId)
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().groupId == existing().groupId
          && incoming().studentId == existing().studentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().status == 'active'
              && incoming().status == 'removed'
              && incoming().removedBy == request.auth.uid
              && incoming().removedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'removedBy', 'removedAt', 'updatedAt'])
            )
            ||
            (
              existing().status == 'removed'
              && incoming().status == 'active'
              && incoming().enrolledBy == request.auth.uid
              && incoming().enrolledAt == request.time
              && get(/databases/$(database)/documents/organizations/$(organizationId)/groups/$(incoming().groupId)).data.status == 'active'
              && get(/databases/$(database)/documents/organizations/$(organizationId)/students/$(incoming().studentId)).data.status == 'active'
              && incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'groupName', 'status', 'enrolledBy', 'enrolledAt', 'updatedAt'])
            )
          );

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Sessions
      // -----------------------------------------------------------------------
      match /sessions/{sessionId} {
        allow get: if isValidId(organizationId) && isValidId(sessionId) && isActiveMember(organizationId);
        allow list: if isActiveMember(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(sessionId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && isValidSession(incoming(), organizationId, sessionId)
          && incoming().status == 'scheduled'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/groups/$(incoming().groupId)).data.status == 'active'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(incoming().teacherId)).data.status == 'active'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(incoming().teacherId)).data.role in ['owner', 'teacher']
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(sessionId)
          && isValidSession(incoming(), organizationId, sessionId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && existing().status != 'cancelled'
          && (existing().status != 'completed' || incoming().status == 'completed')
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().groupId == existing().groupId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'date', 'startTime', 'endTime', 'room', 'status',
            'cancellationReason', 'rescheduleHistory', 'teacherId', 'teacherName', 'updatedAt'
          ]);

        allow delete: if isValidId(organizationId) && isValidId(sessionId) && isOrgOwner(organizationId);
      }

      // -----------------------------------------------------------------------
      // Attendance (Deterministic {sessionId}_{studentId}, enrolled & non-cancelled only)
      // -----------------------------------------------------------------------
      match /attendance/{attendanceId} {
        allow get: if isValidId(organizationId) && isValidId(attendanceId) && isActiveMember(organizationId);
        allow list: if isActiveMember(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(attendanceId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && isValidAttendance(incoming(), organizationId, attendanceId)
          && get(/databases/$(database)/documents/organizations/$(organizationId)/sessions/$(incoming().sessionId)).data.status != 'cancelled'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/sessions/$(incoming().sessionId)).data.groupId == incoming().groupId
          && get(/databases/$(database)/documents/organizations/$(organizationId)/enrollments/$(incoming().groupId + '_' + incoming().studentId)).data.status == 'active'
          && incoming().recordedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(attendanceId)
          && isValidAttendance(incoming(), organizationId, attendanceId)
          && hasAnyRole(organizationId, ['owner', 'teacher', 'assistant'])
          && get(/databases/$(database)/documents/organizations/$(organizationId)/sessions/$(incoming().sessionId)).data.status != 'cancelled'
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().sessionId == existing().sessionId
          && incoming().studentId == existing().studentId
          && incoming().groupId == existing().groupId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'note', 'recordedBy', 'updatedAt'
          ]);

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Payments (Immutable once posted/voided; settlements only on pending/partial)
      // -----------------------------------------------------------------------
      match /payments/{paymentId} {
        allow get: if isValidId(organizationId) && isValidId(paymentId) && hasAnyRole(organizationId, ['owner', 'accountant', 'assistant']);
        allow list: if hasAnyRole(organizationId, ['owner', 'accountant', 'assistant']) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(paymentId)
          && hasAnyRole(organizationId, ['owner', 'accountant', 'assistant'])
          && isValidPayment(incoming(), organizationId, paymentId)
          && incoming().status != 'voided'
          && exists(/databases/$(database)/documents/organizations/$(organizationId)/students/$(incoming().studentId))
          && incoming().recordedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(paymentId)
          && isValidPayment(incoming(), organizationId, paymentId)
          && existing().status != 'voided'
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().studentId == existing().studentId
          && incoming().amount == existing().amount
          && (!('amountPiasters' in existing()) || incoming().amountPiasters == existing().amountPiasters)
          && incoming().currency == existing().currency
          && incoming().category == existing().category
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().status in ['pending', 'partial']
              && hasAnyRole(organizationId, ['owner', 'accountant', 'assistant'])
              && incoming().status in ['posted', 'partial']
              && (!('paidAmountPiasters' in existing()) || incoming().paidAmountPiasters > existing().paidAmountPiasters)
              && incoming().paidAmount > existing().paidAmount
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'amountPiasters', 'paidAmount', 'dueAmount', 'paidAmountPiasters', 'dueAmountPiasters',
                'status', 'method', 'referenceNumber', 'updatedAt'
              ])
            )
            ||
            (
              hasAnyRole(organizationId, ['owner', 'accountant'])
              && incoming().status == 'voided'
              && incoming().paidAmount == existing().paidAmount
              && incoming().dueAmount == existing().dueAmount
              && (!('paidAmountPiasters' in existing()) || incoming().paidAmountPiasters == existing().paidAmountPiasters)
              && (!('dueAmountPiasters' in existing()) || incoming().dueAmountPiasters == existing().dueAmountPiasters)
              && incoming().voidedBy == request.auth.uid
              && incoming().voidedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'amountPiasters', 'paidAmountPiasters', 'dueAmountPiasters',
                'status', 'voidReason', 'voidedBy', 'voidedAt', 'updatedAt'
              ])
            )
          );

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Expenses (Immutable once posted; only voided transition permitted)
      // -----------------------------------------------------------------------
      match /expenses/{expenseId} {
        allow get: if isValidId(organizationId) && isValidId(expenseId) && hasAnyRole(organizationId, ['owner', 'accountant']);
        allow list: if hasAnyRole(organizationId, ['owner', 'accountant']) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(expenseId)
          && hasAnyRole(organizationId, ['owner', 'accountant'])
          && isValidExpense(incoming(), organizationId, expenseId)
          && incoming().status == 'posted'
          && incoming().recordedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), organizationId, expenseId)
          && hasAnyRole(organizationId, ['owner', 'accountant'])
          && existing().status != 'voided'
          && incoming().status == 'voided'
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().amount == existing().amount
          && (!('amountPiasters' in existing()) || incoming().amountPiasters == existing().amountPiasters)
          && incoming().createdAt == existing().createdAt
          && incoming().voidedBy == request.auth.uid
          && incoming().voidedAt == request.time
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'amountPiasters', 'status', 'voidReason', 'voidedBy', 'voidedAt', 'updatedAt'
          ]);

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Immutable Financial Ledger Entries (Append-Only)
      // -----------------------------------------------------------------------
      match /ledgerEntries/{entryId} {
        allow get: if isValidId(organizationId) && isValidId(entryId) && hasAnyRole(organizationId, ['owner', 'accountant', 'assistant']);
        allow list: if hasAnyRole(organizationId, ['owner', 'accountant', 'assistant']) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(entryId)
          && isValidLedgerEntry(incoming(), organizationId, entryId)
          && incoming().recordedBy == request.auth.uid
          && incoming().createdAt == request.time
          && (
            isValidPaymentCreateChargeLedger(organizationId, entryId)
            || isValidPaymentCreateInitPayLedger(organizationId, entryId)
            || isValidPaymentSettlementLedger(organizationId, entryId)
            || isValidPaymentReversalLedger(organizationId, entryId)
            || isValidPaymentAdjustmentLedger(organizationId, entryId)
            || isValidExpenseLedger(organizationId, entryId)
          );

        allow update: if false;
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Idempotency Keys (Create-once lock atomically bound to financial entity)
      // -----------------------------------------------------------------------
      match /idempotencyKeys/{keyId} {
        allow get: if isValidId(organizationId) && isValidId(keyId) && hasAnyRole(organizationId, ['owner', 'accountant', 'assistant']);
        allow list: if false;

        allow create: if isValidId(organizationId)
          && isValidId(keyId)
          && hasAnyRole(organizationId, ['owner', 'accountant', 'assistant'])
          && incoming().keys().hasAll(['id', 'organizationId', 'entityType', 'entityId', 'createdBy', 'createdAt'])
          && incoming().keys().hasOnly(['id', 'organizationId', 'entityType', 'entityId', 'createdBy', 'createdAt'])
          && incoming().id == keyId
          && incoming().organizationId == organizationId
          && incoming().entityType in ['payment', 'expense', 'ledger_entry']
          && isValidId(incoming().entityId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && (
            (
              incoming().entityType == 'payment'
              && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/payments/$(incoming().entityId))
            )
            ||
            (
              incoming().entityType == 'expense'
              && hasAnyRole(organizationId, ['owner', 'accountant'])
              && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/expenses/$(incoming().entityId))
            )
            ||
            (
              incoming().entityType == 'ledger_entry'
              && hasAnyRole(organizationId, ['owner', 'accountant'])
              && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/ledgerEntries/$(incoming().entityId))
            )
          );

        allow update: if false;
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Audit Logs (Append-only, actorRole enforced from authoritative membership)
      // -----------------------------------------------------------------------
      match /auditLogs/{logId} {
        allow get: if isValidId(organizationId) && isValidId(logId) && hasAnyRole(organizationId, ['owner', 'accountant']);
        allow list: if hasAnyRole(organizationId, ['owner', 'accountant']) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(logId)
          && isValidAuditLog(incoming(), organizationId, logId)
          && incoming().createdAt == request.time
          && (
            (
              isActiveMember(organizationId)
              && incoming().actorRole == getMemberData(organizationId).role
            )
            || (
              isVerifiedUser()
              && incoming().actorRole == 'owner'
              && incoming().action == 'organization.created'
              && incoming().entityType == 'organization'
              && incoming().entityId == organizationId
              && !exists(/databases/$(database)/documents/organizations/$(organizationId))
              && existsAfter(/databases/$(database)/documents/organizations/$(organizationId))
              && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerId == request.auth.uid
              && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'owner'
              && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active'
            )
          );

        allow update: if false;
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Staff Invitations
      // -----------------------------------------------------------------------
      match /invitations/{invitationId} {
        allow get: if isValidId(organizationId) && isValidId(invitationId) && isOrgOwner(organizationId);
        allow list: if isOrgOwner(organizationId) && resource.data.organizationId == organizationId;

        allow create: if isValidId(organizationId)
          && isValidId(invitationId)
          && isOrgOwner(organizationId)
          && isValidInvitation(incoming(), organizationId, invitationId)
          && incoming().invitedBy == request.auth.uid
          && incoming().status == 'pending'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(organizationId)
          && isValidId(invitationId)
          && isOrgOwner(organizationId)
          && isValidInvitation(incoming(), organizationId, invitationId)
          && existing().status == 'pending'
          && incoming().status in ['accepted', 'revoked']
          && incoming().id == existing().id
          && incoming().organizationId == existing().organizationId
          && incoming().invitedBy == existing().invitedBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if isValidId(organizationId) && isValidId(invitationId) && isOrgOwner(organizationId);
      }
    }
  }
}
